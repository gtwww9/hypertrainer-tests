```
# Android build artifacts
*.apk
*.aar
*.dex

# Android build directories
build/
.externalNativeBuild/
.intermediates/
outputs/

# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA artifacts
*.iml
*.ipr
*.iws
.idea/

# Temporary files
*.tmp
*.temp
*.bak

# Environment variables
.env
.env.local
*.env.*

# Coverage reports
coverage/
*.lcov
*.profdata

# Distribution / packaging
*.tar.gz
*.zip
dist/
target/

# Python-related (if any Python scripts in project)
__pycache__/
*.pyc
*.pyo
.Python
*.so
.coverage
.htmlcov/
.mypy_cache/
.pytest_cache/

# Node.js (if any JS in project)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env.test
```